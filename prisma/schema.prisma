generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(ADMIN)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  galleries Gallery[]
  posts     Post[]

  @@map("users")
}

model Notice {
  id        String   @id @default(uuid())
  title     String
  content   String
  isPinned  Boolean  @default(false) @map("is_pinned")
  views     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt(sort: Desc)])
  @@index([isPinned])
  @@map("notices")
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  author    String
  password  String?
  isSecret  Boolean  @default(false) @map("is_secret")
  views     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  replies   Reply[]

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("posts")
}

model Reply {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("replies")
}

model Gallery {
  id        String   @id @default(uuid())
  title     String
  content   String?
  images    String[]
  views     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("galleries")
}

model Inquiry {
  id         String        @id @default(uuid())
  name       String
  email      String
  phone      String
  company    String?
  message    String
  status     InquiryStatus @default(PENDING)
  adminReply String?       @map("admin_reply")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("inquiries")
}

model Popup {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String   @map("image_url")
  link      String?
  posX      Int      @default(0) @map("pos_x")
  posY      Int      @default(100) @map("pos_y")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, startDate, endDate])
  @@map("popups")
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum InquiryStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}
